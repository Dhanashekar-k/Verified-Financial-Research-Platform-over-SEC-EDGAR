# Copy to .env (gitignored) and fill in.
# IMPORTANT: never name the key ANTHROPIC_API_KEY. If you do, Claude Code bills your API
# credits instead of your Max subscription. The app reads EDGARQA_ANTHROPIC_API_KEY explicitly.
EDGARQA_ANTHROPIC_API_KEY=

# LLM mode: live | stub | record | replay | batch
EDGARQA_LLM_MODE=live

# SEC fair-access settings: a User-Agent with your name and email; stay under 10 req/s in total
SEC_USER_AGENT="Your Name your-email@example.com"
SEC_MAX_RPS=8

DATABASE_URL=postgresql://edgarqa:edgarqa@localhost:5432/edgarqa
REDIS_URL=redis://localhost:6379/0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Iceberg environment: local | emr
ICEBERG_ENV=local
LAKE_BUCKET=
AWS_PROFILE=edgarqa
AWS_REGION=us-east-1

DAILY_SPEND_CAP_USD=2.00
API_KEY_PEPPER=change-me-local-only
