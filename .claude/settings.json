{
  "permissions": {
    "allow": [
      "Bash(make test *)",
      "Bash(make lint *)",
      "Bash(make fmt *)",
      "Bash(make up *)",
      "Bash(make status *)",
      "Bash(make check-gold *)",
      "Bash(make bench *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run mypy *)",
      "Bash(uv run python -m eval.run *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(terraform fmt *)",
      "Bash(terraform validate *)"
    ],
    "ask": [
      "Bash(terraform plan *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(aws *)",
      "Bash(git push *)",
      "Bash(docker compose down *)",
      "Bash(make tf-apply *)",
      "Bash(make emr-run *)",
      "Bash(make deploy *)",
      "Bash(make destroy-compute *)",
      "Bash(make destroy-all *)",
      "Bash(make remote-load *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(**/*.pem)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.backup)",
      "Bash(rm -rf *)",
      "Bash(aws s3 rm *)",
      "Bash(aws s3 rb *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-paths.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-python.sh"
          }
        ]
      }
    ]
  }
}
